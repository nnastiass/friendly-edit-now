<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      This configuration allows the app to make cleartext HTTP requests,
      but ONLY to the specified local IP addresses for development purposes.
      Production traffic to other domains will still default to requiring HTTPS.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!--
            Allow localhost for Android emulators (special IP address that
            maps to your host machine's localhost).
        -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!--
            Allow your development machine's current local IP address (192.168.0.140).
            Ensure this matches the IP address of your backend server.
        -->
        <domain includeSubdomains="true">192.168.0.140</domain>
    </domain-config>

    <!--
      This is the default configuration for all other domains not listed above.
      It enforces the standard security practice of disallowing cleartext traffic,
      meaning all other external API calls will require HTTPS.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
